{
  "plugins": [
    {
      "name": "dartvision-filesystem",
      "command": "node",
      "args": ["src/filesystem/index.js"],
      "env": {
        "ALLOWED_DIRECTORIES": ["C:\\"]
      }
    },
    {
      "name": "dartvision-terminal",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "src/terminal/run.ps1"]
    },
    {
      "name": "dartvision-sequential-thinking",
      "command": "node",
      "args": ["src/sequentialthinking/index.js"]
    },
    {
      "name": "dartvision-network-fetch",
      "command": "node",
      "args": ["src/fetch/index.js"]
    },
    {
      "name": "dartvision-codebase-memory",
      "command": "node",
      "args": ["src/codebase-memory/index.js"]
    },
    {
      "name": "dartvision-visual-verify",
      "command": "node",
      "args": ["src/visualverify/index.js"]
    },
    {
      "name": "dartvision-error-triage",
      "command": "node",
      "args": ["src/errortriage/index.js"]
    },
    {
      "name": "dartvision-self-extend",
      "command": "node",
      "args": ["src/installer/plugin-installer.js"]
    },
    {
      "name": "dartvision-git-control",
      "command": "node",
      "args": ["src/git/index.js"]
    },
    {
      "name": "dartvision-live-docs",
      "command": "node",
      "args": ["src/docs/index.js"]
    },
    {
      "name": "dartvision-prompts",
      "command": "node",
      "args": ["src/prompts/index.js"]
    }
  ]
}
